generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-1.1.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────
// Enums (each value must be on its own line)
// ─────────────────────────────────────────────

enum UserRole {
  CUSTOMER
  EDITOR
  SELLER
  ADMIN
}

enum AccountStatus {
  ACTIVE
  SUSPENDED
}

enum ProductStatus {
  PUBLISHED
  UNPUBLISHED
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
}

enum PaymentMethod {
  COD
  BKASH
  NAGAD
  ROCKET
  SSLCOMMERZ
  STRIPE
}

enum PaymentStatus {
  PENDING
  AUTHORIZED
  PAID
  FAILED
  REFUNDED
}

enum CouponType {
  PERCENT
  FLAT
}

enum DealType {
  TODAYS_DEAL
  BUY_ONE_GET_ONE
  FREE_SHIPPING
  BEST_PRICE
  CLEARANCE_SALE
}

enum HomepageDisplayType {
  RAIL
  GRID
  TILES
  COLLECTION
  BANNER
}

// ─────────────────────────────────────────────
// Users & auth
// ─────────────────────────────────────────────

model User {
  id            String         @id @default(uuid()) @db.Uuid
  name          String
  email         String         @unique
  passwordHash  String?
  role          UserRole       @default(CUSTOMER)
  status        AccountStatus  @default(ACTIVE)
  avatarUrl     String?
  phone         String?
  walletBalance Decimal        @default(0) @db.Decimal(12, 2)
  rewardPoints  Int            @default(0)
  seller        Seller?
  addresses     Address[]
  accounts      Account[]
  sessions      Session[]
  carts         Cart[]
  wishlists     Wishlist[]
  compareLists  CompareList[]
  orders        Order[]
  reviews       Review[]
  notifications Notification[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([role, status])
}

model Account {
  id                String  @id @default(cuid())
  userId            String  @db.Uuid
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String   @db.Uuid
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Seller {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @unique @db.Uuid
  slug      String    @unique
  name      String
  logoUrl   String?
  rating    Decimal   @default(0) @db.Decimal(3, 2)
  since     String?
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  products  Product[]
  createdAt DateTime  @default(now())
}

model Address {
  id        String  @id @default(uuid()) @db.Uuid
  userId    String  @db.Uuid
  label     String
  fullName  String
  phone     String
  district  String
  area      String
  street    String
  isDefault Boolean @default(false)
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders    Order[]

  @@index([userId, isDefault])
}

// ─────────────────────────────────────────────
// Catalog
// ─────────────────────────────────────────────

model Product {
  id               String                @id @default(uuid()) @db.Uuid
  slug             String                @unique
  sku              String                @unique
  isbn             String?               @unique
  title            String
  description      String                @db.Text
  shortDescription String?
  translator       String?
  edition          String?
  pages            Int?
  language         String?
  binding          String?
  weightGrams      Int?
  regularPrice     Decimal               @db.Decimal(12, 2)
  salePrice        Decimal?              @db.Decimal(12, 2)
  status           ProductStatus         @default(PUBLISHED)
  featured         Boolean               @default(false)
  bestseller       Boolean               @default(false)
  newRelease       Boolean               @default(false)
  editorChoice     Boolean               @default(false)
  awardWinner      Boolean               @default(false)
  ratingAverage    Decimal               @default(0) @db.Decimal(3, 2)
  ratingCount      Int                   @default(0)
  sellerId         String?               @db.Uuid
  publisherId      String?               @db.Uuid
  seller           Seller?               @relation(fields: [sellerId], references: [id], onDelete: SetNull)
  publisher        Publisher?            @relation(fields: [publisherId], references: [id], onDelete: SetNull)
  images           ProductImage[]
  variants         ProductVariant[]
  inventory        Inventory?
  authors          ProductAuthor[]
  categories       ProductCategory[]
  tags             ProductTag[]
  cartItems        CartItem[]
  wishlistItems    WishlistItem[]
  compareItems     CompareItem[]
  orderItems       OrderItem[]
  reviews          Review[]
  dealProducts     DealProduct[]
  sectionItems     HomepageSectionItem[]
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  @@index([status, createdAt])
  @@index([bestseller, newRelease, featured])
  @@index([sellerId])
  @@index([publisherId])
}

model ProductImage {
  id        String  @id @default(uuid()) @db.Uuid
  productId String  @db.Uuid
  url       String
  alt       String?
  sortOrder Int     @default(0)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, sortOrder])
}

model ProductVariant {
  id           String     @id @default(uuid()) @db.Uuid
  productId    String     @db.Uuid
  sku          String     @unique
  name         String
  regularPrice Decimal    @db.Decimal(12, 2)
  salePrice    Decimal?   @db.Decimal(12, 2)
  product      Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  inventory    Inventory?

  @@index([productId])
}

model Inventory {
  id        String          @id @default(uuid()) @db.Uuid
  productId String?         @unique @db.Uuid
  variantId String?         @unique @db.Uuid
  quantity  Int             @default(0)
  reserved  Int             @default(0)
  product   Product?        @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)
  updatedAt DateTime        @updatedAt
}

model Author {
  id       String          @id @default(uuid()) @db.Uuid
  slug     String          @unique
  name     String
  bio      String?         @db.Text
  photoUrl String?
  products ProductAuthor[]
}

model Publisher {
  id       String    @id @default(uuid()) @db.Uuid
  slug     String    @unique
  name     String
  products Product[]
}

model Category {
  id               String            @id @default(uuid()) @db.Uuid
  slug             String            @unique
  name             String
  icon             String?
  parentId         String?           @db.Uuid
  parent           Category?         @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children         Category[]        @relation("CategoryTree")
  products         ProductCategory[]
  homepageSections HomepageSection[]

  @@index([parentId])
}

model ProductAuthor {
  productId String  @db.Uuid
  authorId  String  @db.Uuid
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  author    Author  @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@id([productId, authorId])
}

model ProductCategory {
  productId  String   @db.Uuid
  categoryId String   @db.Uuid
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([productId, categoryId])
}

model Tag {
  id       String       @id @default(uuid()) @db.Uuid
  slug     String       @unique
  name     String
  products ProductTag[]
}

model ProductTag {
  productId String  @db.Uuid
  tagId     String  @db.Uuid
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  tag       Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([productId, tagId])
}

// ─────────────────────────────────────────────
// Cart, wishlist, compare
// ─────────────────────────────────────────────

model Cart {
  id         String     @id @default(uuid()) @db.Uuid
  userId     String?    @db.Uuid
  guestToken String?    @unique
  user       User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  items      CartItem[]
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  @@index([userId])
}

model CartItem {
  id        String  @id @default(uuid()) @db.Uuid
  cartId    String  @db.Uuid
  productId String  @db.Uuid
  quantity  Int
  cart      Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([cartId, productId])
}

model Wishlist {
  id         String         @id @default(uuid()) @db.Uuid
  userId     String?        @db.Uuid
  guestToken String?        @unique
  user       User?          @relation(fields: [userId], references: [id], onDelete: Cascade)
  items      WishlistItem[]

  @@index([userId])
}

model WishlistItem {
  wishlistId String   @db.Uuid
  productId  String   @db.Uuid
  wishlist   Wishlist @relation(fields: [wishlistId], references: [id], onDelete: Cascade)
  product    Product  @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@id([wishlistId, productId])
}

model CompareList {
  id         String        @id @default(uuid()) @db.Uuid
  userId     String?       @db.Uuid
  guestToken String?       @unique
  user       User?         @relation(fields: [userId], references: [id], onDelete: Cascade)
  items      CompareItem[]

  @@index([userId])
}

model CompareItem {
  compareListId String      @db.Uuid
  productId     String      @db.Uuid
  compareList   CompareList @relation(fields: [compareListId], references: [id], onDelete: Cascade)
  product       Product     @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@id([compareListId, productId])
}

// ─────────────────────────────────────────────
// Orders & payments
// ─────────────────────────────────────────────

model Order {
  id            String          @id @default(cuid())
  userId        String?         @db.Uuid
  addressId     String?         @db.Uuid
  status        OrderStatus     @default(PENDING)
  subtotal      Decimal         @db.Decimal(12, 2)
  shipping      Decimal         @db.Decimal(12, 2)
  discount      Decimal         @default(0) @db.Decimal(12, 2)
  total         Decimal         @db.Decimal(12, 2)
  couponCode    String?
  paymentMethod PaymentMethod   @default(COD)
  shippingAddress Json?
  user          User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  address       Address?        @relation(fields: [addressId], references: [id], onDelete: SetNull)
  items         OrderItem[]
  payment       Payment?
  timeline      OrderTimeline[]
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([userId, createdAt])
  @@index([status, createdAt])

}

model OrderItem {
  id        String  @id @default(uuid()) @db.Uuid
  orderId   String
  productId String  @db.Uuid
  title     String
  coverUrl  String?
  price     Decimal @db.Decimal(12, 2)
  quantity  Int
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([productId])
}

model Payment {
  id          String        @id @default(uuid()) @db.Uuid
  orderId     String        @unique
  status      PaymentStatus @default(PENDING)
  providerRef String?
  amount      Decimal       @db.Decimal(12, 2)
  order       Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

model OrderTimeline {
  id        String      @id @default(uuid()) @db.Uuid
  orderId   String
  status    OrderStatus
  note      String?
  createdAt DateTime    @default(now())
  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
}

model Coupon {
  code      String     @id
  type      CouponType
  value     Decimal    @db.Decimal(12, 2)
  minSpend  Decimal    @default(0) @db.Decimal(12, 2)
  active    Boolean    @default(true)
  expiresAt DateTime?
  createdAt DateTime   @default(now())

  @@index([active, expiresAt])
}

// ─────────────────────────────────────────────
// Reviews & notifications
// ─────────────────────────────────────────────

model Review {
  id        String   @id @default(uuid()) @db.Uuid
  productId String   @db.Uuid
  userId    String   @db.Uuid
  rating    Int
  title     String?
  body      String   @db.Text
  approved  Boolean  @default(false)
  helpful   Int      @default(0)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([productId, userId])
  @@index([productId, approved, createdAt])
  @@index([userId])
}

model Notification {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  title     String
  body      String   @db.Text
  read      Boolean  @default(false)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([userId, read, createdAt])
}

// ─────────────────────────────────────────────
// Deals & homepage
// ─────────────────────────────────────────────

model DealCampaign {
  id           String        @id @default(uuid()) @db.Uuid
  name         String
  slug         String        @unique
  type         DealType
  description  String?       @db.Text
  banner       String?
  startAt      DateTime
  endAt        DateTime?
  active       Boolean       @default(true)
  displayOrder Int           @default(0)
  products     DealProduct[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @default(now()) @updatedAt

  @@index([active, startAt, endAt, displayOrder])
}

model DealProduct {
  id            String       @id @default(uuid()) @db.Uuid
  campaignId    String       @db.Uuid
  productId     String       @db.Uuid
  originalPrice Decimal      @db.Decimal(12, 2)
  dealPrice     Decimal      @db.Decimal(12, 2)
  stockLimit    Int?
  soldCount     Int          @default(0)
  displayOrder  Int          @default(0)
  active        Boolean      @default(true)
  campaign      DealCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  product       Product      @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([campaignId, productId])
  @@index([campaignId, active, displayOrder])
  @@index([productId])
}

model HomepageSection {
  id           String                @id @default(uuid()) @db.Uuid
  title        String
  slug         String                @unique
  displayType  HomepageDisplayType
  active       Boolean               @default(true)
  displayOrder Int                   @default(0)
  bannerUrl    String?
  categoryId   String?               @db.Uuid
  category     Category?             @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  items        HomepageSectionItem[]

  @@index([active, displayOrder])
  @@index([categoryId])
}

model HomepageSectionItem {
  sectionId    String          @db.Uuid
  productId    String          @db.Uuid
  displayOrder Int             @default(0)
  section      HomepageSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  product      Product         @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([sectionId, productId])
  @@index([sectionId, displayOrder])
  @@index([productId])
}

model Banner {
  id         String   @id @default(cuid())
  title      String
  subtitle   String?
  ctaLabel   String?
  ctaHref    String?
  imageUrl   String?
  background String?
  placement  String?
  active     Boolean  @default(true)
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())

  @@index([active, placement, sortOrder])
}

// ─────────────────────────────────────────────
// Misc
// ─────────────────────────────────────────────

model StoreSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

model NewsletterSubscriber {
  email     String   @id
  createdAt DateTime @default(now())
}

model SearchHistory {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String?  @db.Uuid
  query     String
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([query])
}
